# Copy to .env and fill in. Without a key Foreman runs in extractive mode (verbatim steps, no vision checks).
ANTHROPIC_API_KEY=
# FOREMAN_MODEL=claude-opus-5
# Organization-level keys must name a workspace; keys created inside a workspace do not.
# ANTHROPIC_WORKSPACE_ID=

# Where Docling's models run: auto (default), cpu, mps (Apple Silicon), cuda.
# FOREMAN_ACCELERATOR=auto
# FOREMAN_TABLE_MODE=accurate   # "fast" ingests quicker, with less exact table cells

# Data stores (defaults match docker-compose.yml)
# DATABASE_URL=postgresql://foreman:foreman@localhost:5433/foreman
# QDRANT_URL=http://localhost:6333
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=foreman-graph

# FOREMAN_OFFLINE=1        # force extractive mode even with a key
# FOREMAN_SEED=0           # do not load the demo library on first start
# FOREMAN_DATA_DIR=./data   # file store: PDFs, page images, photos
